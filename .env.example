# MANTA — local setup (step 2 of the README). Copy to apps/manta_web/backend/.env and fill in;
# .env is gitignored. The container stack (step 1) uses deploy/.env.example instead.

# Required: the same Neo4j password as NEO4J_PASSWORD in deploy/.env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Assistant (optional). Without a running Ollama it reports "not ready";
# everything else works regardless.
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b and qwen2.5:1.5b: Apache 2.0.
OLLAMA_MODEL=qwen2.5:7b

# Taxonomy: a PR2 reference in DADA2 format (from github.com/pr2database/pr2database/releases).
# Without it the ASVs stay "unassigned"; the run still succeeds. Only used for raw FASTQ input.
# MANTA_PR2=/path/to/pr2_version_5.1.0_SSU_dada2.fasta.gz

# Database connection of the ingest tool (tools/neo4j_ingest/ingest.py, also used by imports
# started from the interface). Defaults follow each name and are usually enough.
# MANTA_NEO4J_CONNECT_TIMEOUT=120   connecting to the database, in seconds
# MANTA_NEO4J_CONNECT_ATTEMPTS=5    attempts before giving up
# MANTA_NEO4J_CONNECT_BACKOFF=30    wait between attempts, in seconds
