# MANTA — Entwicklungs-Umgebung. Kopieren nach apps/manta_web/backend/.env und ausfuellen
# (.env ist gitignored; das README zeigt wohin). Fuer den Container-Betrieb gilt stattdessen
# deploy/.env.example.

# Pflicht: die Zugangsdaten des lokalen Neo4j-Containers (docker run im README).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bitte-aendern

# Assistent (optional). Ohne laufendes Ollama meldet er ehrlich "nicht bereit" —
# der Rest der Plattform funktioniert trotzdem.
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b und qwen2.5:1.5b: Apache 2.0. qwen2.5:3b: Qwen Research License (nicht kommerziell).
OLLAMA_MODEL=qwen2.5:7b

# Taxonomie: PR2-Referenz im DADA2-Format (Datei von pr2database/releases). Ohne sie bleiben die
# ASVs "unassigned" — der Lauf gelingt trotzdem. Gilt nur fuer den FASTQ-Eingang.
# MANTA_PR2=/pfad/zu/pr2_version_5.0.0_SSU_dada2.fasta.gz
