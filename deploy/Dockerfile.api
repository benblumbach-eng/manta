FROM python:3.12.15-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

WORKDIR /app
COPY apps/manta_web/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --root-user-action=ignore --disable-pip-version-check \
    -r /app/requirements.txt

COPY apps/manta_web/backend /app/apps/manta_web/backend
COPY apps/manta_mcp /app/apps/manta_mcp

RUN useradd --no-log-init --uid 10001 --create-home --home-dir /home/manta manta \
    && mkdir -p /data && chown -R manta:manta /data /app
USER manta

ENV PYTHONUNBUFFERED=1
WORKDIR /app/apps/manta_web/backend
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
