{$MANTA_SITE_ADDRESS::80} {
	encode gzip zstd

	handle_path /api/* {
		@mit_dateien path /import/upload /import/fastq
		request_body @mit_dateien {
			max_size 32GB
		}
		@ohne_dateien not path /import/upload /import/fastq
		request_body @ohne_dateien {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			lb_try_duration 20s
			lb_try_interval 500ms
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header X-Robots-Tag "noindex, nofollow"

	@nicht_assets not path /assets/* /api/*
	header @nicht_assets Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@ueber_https expression {scheme} == "https"
	header @ueber_https Strict-Transport-Security "max-age={$MANTA_HSTS_MAX_AGE:86400}"
}
