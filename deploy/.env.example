# MANTA — deployment configuration. Copy to .env and fill in (.env is gitignored).

# Required. Neo4j refuses to start without it, and a default password on a network is none.
# Choose your own, long one — not an example value from a manual. Neo4j requires at least
# 8 characters and does not start with a shorter one.
NEO4J_PASSWORD=change-me

# Memory caps. Sized for an 8 GB machine; raise them on larger hardware.
# The real memory eater is not Neo4j but Ollama (see below).
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M
# Upper limit for any single database transaction (0s = unlimited). Stops a runaway query
# from occupying the database after the client has given up. Raise it only for an unusually
# long load; it can also be changed at runtime without a restart.
NEO4J_TX_TIMEOUT=60s

# Under which name the instance runs.
#   ":80"               -> local, HTTP, no certificate
#   "manta.example.org" -> Caddy fetches the Let's Encrypt certificate itself. For that, ports 80
#                          AND 443 must be reachable from outside and the A record must point here.
MANTA_SITE_ADDRESS=:80

# Which address the interface binds to. 127.0.0.1 = this machine only, which matches the README
# ('on your own machine, in your browser'). For a real server that is MEANT to be reachable from
# outside, set this to 0.0.0.0 deliberately.
WEB_BIND=127.0.0.1

# Where the proxy's ports land. On a server the real ones: HTTP_PORT=80, HTTPS_PORT=443.
# Deliberately high locally so nothing collides with other services.
HTTP_PORT=8080
HTTPS_PORT=8443

# Database binding. Loopback: reachable only on the machine itself or through an SSH tunnel —
# this is how new datasets get onto the server. Never 0.0.0.0.
NEO4J_BIND=127.0.0.1
# Host ports of the database. Change only if a Neo4j is already running on this machine — Neo4j
# Desktop, say, or a development container holding the default ports.
NEO4J_PORT_BOLT=7687
NEO4J_PORT_HTTP=7474

# The API address in the frontend. Relative, because interface and API share one origin.
# There is normally no reason to change this.
VITE_API_BASE=/api

# CORS. Through the proxy the browser makes no cross-origin requests at all; this entry exists
# for development with Vite on 5173. NEVER "*".
MANTA_ALLOWED_ORIGINS=http://localhost:5173

# THE ASSISTANT IS OPT-IN. Empty = the stack starts WITHOUT the model service; everything but the
# chat keeps working (map, networks, ASV pages, tools, vocabulary), and the chat says that no
# model is reachable. To switch it on:
#
#   COMPOSE_PROFILES=assistant
#
# Then `docker compose up -d` once and pull the model (see below). If you use your own model
# through a key instead (MANTA_OPENAI_* further down), leave this empty.
COMPOSE_PROFILES=

# The model is not pulled automatically:
#   docker compose exec ollama ollama pull qwen2.5:7b
# qwen2.5:7b (4.7 GB) and qwen2.5:1.5b (1 GB, for 8 GB machines) are Apache 2.0.
# qwen2.5:3b is under the Qwen Research License: research and evaluation only, not commercial.
# Without a model /api/agent/status reports honestly that it is not ready.
OLLAMA_MODEL=qwen2.5:7b
# Host port of the model service (this machine only), when the assistant profile is on. The local
# setup from README step 2 reaches the model here. Change it if a native Ollama already uses 11434.
OLLAMA_PORT=11434

# HSTS, in seconds; sent only over HTTPS. Raise to 31536000 (one year) only after a few stable
# weeks with a certificate.
MANTA_HSTS_MAX_AGE=86400

# ---------------------------------------------------------------------------------------
# Access requests. The form on the sign-in page sends a notification to whoever is responsible.
# WITHOUT these settings everything keeps working: the request is stored and appears in the admin
# panel — nobody is notified, and the interface says exactly that ("No mail server is configured").
# ---------------------------------------------------------------------------------------

# The CATCH-ALL address. Receives EVERY request, in addition to any topic assignment (which is
# maintained in the admin panel, not here — it should be changeable without a restart).
# Separate several addresses with commas. Left empty, there is no fallback recipient.
MANTA_REQUEST_MAILTO=

# The mail server. Without a host nothing is sent (a valid state, not an error).
MANTA_SMTP_HOST=
MANTA_SMTP_PORT=587
# starttls (default, port 587) | ssl (port 465) | none
MANTA_SMTP_TLS=starttls
MANTA_SMTP_USER=
MANTA_SMTP_PASSWORD=

# Sender address. Many servers refuse a foreign sender address (SPF) — which is why this is YOUR
# OWN address, and the person who filed the request goes into Reply-To.
MANTA_MAIL_FROM=manta@localhost

# The address under which people see the interface. ONLY for the link in the notification mail
# ("straight to the request"). Without it the API builds the address from the proxy's forwarding
# headers — usually right, but not behind every setup. With a certificate, put the real https
# address here, e.g. https://manta.example.org
MANTA_PUBLIC_URL=

# ---------------------------------------------------------------------------------------
# Assistant — models and the evidence rule
# ---------------------------------------------------------------------------------------

# EVIDENCE RULE for numbers. Every number in an answer is checked against what the tools
# returned; a number from the QUESTION explicitly does not count as evidence, because otherwise a
# question could plant a number and have it come back as a checked answer.
#   mark    default — the number stays and carries "[no evidence]" right behind it
#   refuse  the whole answer is discarded and replaced by a note
#   off     no check. For comparison measurements only, not for running an instance.
MANTA_GROUNDING=mark

# YOUR OWN MODEL through an OpenAI-compatible interface. Leave empty = local Ollama models only.
# Both together is fine: local and remote models share one switch, and the MODEL NAME decides
# which way a question takes.
#
# MIND THE COST: the key belongs to the operator, and EVERY question of EVERY signed-in user is
# billed to it. Guests cannot ask (/agent/ask requires a sign-in) — signed-in users can. If you do
# not want that, leave the three fields empty.
#
# Examples for the base address:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   local       http://host.docker.internal:<port>/v1   (llama.cpp, vLLM, LM Studio on this machine)
# For a server on this machine, use host.docker.internal, not localhost: the API runs in a
# container, where localhost is the container itself. On Linux that server must listen on
# 0.0.0.0 (or the Docker bridge address), not only on 127.0.0.1. Pick a port other than HTTP_PORT.
MANTA_OPENAI_BASE_URL=https://api.openai.com/v1
MANTA_OPENAI_API_KEY=
# Comma-separated; the first one is the default. WITHOUT this list nothing is offered — a guessed
# default model would be a cost nobody chose.
MANTA_OPENAI_MODELS=
MANTA_OPENAI_TIMEOUT=120

# --- Further settings; the defaults follow each name and are usually enough. ---
# MANTA_SESSION_DAYS=30           how long a sign-in stays valid, in days
# MANTA_MIN_PASSWORD_LEN=8        minimum length of new passwords
# MANTA_SMTP_TIMEOUT=10           timeout when sending mail, in seconds
# OLLAMA_NUM_CTX=16384            context window of the local model
# OLLAMA_TEMPERATURE (unset)      spread of the assistant's answers, e.g. OLLAMA_TEMPERATURE=0.2.
#                                 Unset = the model's own default. Never set it to an empty value.
# MANTA_BACKUP_KEEP=14            how many backups deploy/backup.sh keeps (read by backup.sh
#                                 from this file or from the shell)
# MANTA_ADMINS_READ_TRANSCRIPTS=on  every assistant conversation is saved to its account; "on"
#                                 lets administrators read all of them (the chat says so), "off"
#                                 keeps each account's transcripts to itself.
# MANTA_SECRET_KEY (unset)        key that encrypts each account's own model key. Unset = a key
#                                 file manta_secret.key is created next to the account database.
#
# The database connection settings MANTA_NEO4J_CONNECT_* belong to the ingest tool
# (tools/neo4j_ingest/ingest.py), not to this stack; see .env.example in the repository root.
