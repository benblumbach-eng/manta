# MANTA — Deployment-Konfiguration. Kopieren nach .env und ausfuellen (.env ist gitignored).

# Pflicht. Neo4j weigert sich ohne, und ein Standardpasswort im Netz ist keins.
# Ein eigenes, langes Passwort waehlen — kein Beispielwert aus einer Anleitung.
NEO4J_PASSWORD=bitte-aendern

# Speicherdeckel. Fuer eine 8-GB-Maschine passend; auf groesserer Hardware hochsetzen.
# Der eigentliche Speicherfresser ist nicht Neo4j, sondern Ollama (s. unten).
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M

# Unter welchem Namen die Instanz laeuft.
#   ":80"        -> lokal, HTTP, kein Zertifikat
#   "manta.example.org" -> Caddy holt das Let's-Encrypt-Zertifikat selbst. Dafuer muessen Port 80 UND
#                   443 von aussen erreichbar sein und der A-Record auf diese Maschine zeigen.
MANTA_SITE_ADDRESS=:80

# An welche Adresse die Oberflaeche gebunden wird. 127.0.0.1 = nur dieser Rechner; das passt zu
# der Zusage "locally in your browser" im README. Fuer einen echten Server, der von aussen
# erreichbar sein SOLL, bewusst auf 0.0.0.0 setzen.
WEB_BIND=127.0.0.1

# Wo die Ports des Proxys landen. Auf dem Server die echten: HTTP_PORT=80, HTTPS_PORT=443.
# Lokal absichtlich hoch gelegt, damit nichts mit anderen Diensten kollidiert.
HTTP_PORT=8080
HTTPS_PORT=8443

# Datenbank-Bindung. Loopback: erreichbar nur auf der Maschine selbst bzw. durch einen
# SSH-Tunnel — so kommen neue Datensaetze auf den Server. Niemals 0.0.0.0.
NEO4J_BIND=127.0.0.1
# Host-Ports der DB. Nur aendern, wenn auf derselben Maschine schon eine Neo4j laeuft — etwa
# Neo4j Desktop oder ein Entwicklungs-Container, der die Standardports belegt.
NEO4J_PORT_BOLT=7687
NEO4J_PORT_HTTP=7474

# Die API-Adresse im Frontend. Relativ, weil Oberflaeche und API denselben Ursprung haben.
# Es gibt normalerweise keinen Grund, das zu aendern.
VITE_API_BASE=/api

# CORS. Durch den Proxy stellt der Browser gar keine Cross-Origin-Anfragen mehr; der Eintrag
# ist nur fuer die Entwicklung mit Vite auf 5173 da. KEIN "*".
MANTA_ALLOWED_ORIGINS=http://localhost:5173

# Assistent. Das Modell wird nicht automatisch geholt:
#   docker compose exec ollama ollama pull qwen2.5:7b
# qwen2.5:7b (4,7 GB) und qwen2.5:1.5b (1 GB, fuer 8-GB-Maschinen) stehen unter Apache 2.0.
# qwen2.5:3b steht unter der Qwen Research License: nur Forschung/Evaluation, nicht kommerziell.
# Ohne Modell meldet /api/agent/status ehrlich "nicht bereit".
OLLAMA_MODEL=qwen2.5:7b

# HSTS. Erst nach ein paar stabilen Wochen mit Zertifikat auf 31536000 (ein Jahr) hochsetzen.
MANTA_HSTS_MAX_AGE=86400

# ---------------------------------------------------------------------------------------
# Zugangsantraege. Das Formular auf der Anmeldeseite schickt eine
# Benachrichtigung an die Zustaendigen. OHNE diese Angaben laeuft alles weiter: der Antrag wird
# gespeichert und steht im Admin-Panel — es wird nur niemand benachrichtigt, und genau das sagt
# die Oberflaeche dann auch ("No mail server is configured").
# ---------------------------------------------------------------------------------------

# Die SAMMELADRESSE. Bekommt JEDEN Antrag, zusaetzlich zu einer eventuellen Themen-Zuordnung
# (die wird im Admin-Panel gepflegt, nicht hier — sie soll ohne Neustart aenderbar sein).
# Mehrere Adressen mit Komma trennen. Bleibt sie leer, gibt es keinen Rueckfall-Empfaenger.
MANTA_REQUEST_MAILTO=

# Der Mailserver. Ohne Host wird nichts verschickt (zulaessiger Betriebszustand, kein Fehler).
MANTA_SMTP_HOST=
MANTA_SMTP_PORT=587
# starttls (Vorgabe, Port 587) | ssl (Port 465) | none
MANTA_SMTP_TLS=starttls
MANTA_SMTP_USER=
MANTA_SMTP_PASSWORD=

# Absenderadresse. Viele Server verweigern eine fremde Absenderadresse (SPF) — deshalb steht
# hier eine EIGENE Adresse, und der Antragsteller haengt in Reply-To.
MANTA_MAIL_FROM=manta@localhost

# Unter welcher Adresse Menschen die Oberflaeche sehen. NUR fuer den Link in der
# Benachrichtigungsmail ("Direkt zum Antrag"). Ohne diese Angabe baut die API die Adresse aus
# den Weiterleitungskopfzeilen des Proxys — das stimmt meistens, aber nicht hinter jedem
# Aufbau. Mit Zertifikat also die echte https-Adresse eintragen, z.B. https://manta.example.org
MANTA_PUBLIC_URL=

# ---------------------------------------------------------------------------------------
# Assistent — Modelle und Beleg-Pflicht
# ---------------------------------------------------------------------------------------

# BELEG-PFLICHT fuer Zahlen. Jede Zahl der Antwort wird gegen das geprueft, was die Werkzeuge
# geliefert haben; eine Zahl aus der FRAGE gilt ausdruecklich nicht als Beleg (das war ein
# erfolgreicher Angriff in der Erprobung).
#   mark    Vorgabe — die Zahl bleibt stehen und traegt "[ohne Beleg]" direkt hinter sich
#   refuse  die ganze Antwort wird verworfen und durch einen Hinweis ersetzt
#   off     keine Pruefung. Nur fuer Vergleichsmessungen, nicht fuer den Betrieb.
MANTA_GROUNDING=mark

# EIN EIGENES MODELL ueber eine OpenAI-kompatible Schnittstelle. Leer lassen = nur die lokalen
# Ollama-Modelle. Beides zusammen geht: lokale und entfernte Modelle stehen im selben
# Umschalter, der MODELLNAME entscheidet, welcher Weg genommen wird.
#
# ACHTUNG, Kosten: der Schluessel gehoert dem Betreiber, und JEDE Frage JEDES angemeldeten
# Nutzers wird darueber abgerechnet. Gaeste koennen nicht fragen (/agent/ask verlangt eine
# Anmeldung) — angemeldete Nutzer schon. Wer das nicht will, laesst die drei Felder leer.
#
# Beispiele fuer die Basis-Adresse:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   lokal       http://localhost:8080/v1   (llama.cpp, vLLM, LM Studio)
MANTA_OPENAI_BASE_URL=https://api.openai.com/v1
MANTA_OPENAI_API_KEY=
# Komma-getrennt; der erste ist die Vorgabe. OHNE diese Liste wird nichts angeboten — ein
# geratenes Vorgabemodell waere ein Preis, den niemand gewaehlt hat.
MANTA_OPENAI_MODELS=
MANTA_OPENAI_TIMEOUT=120

# --- Weitere Einstellungen; die Vorgaben stehen dahinter und genuegen meistens. ---
# MANTA_SESSION_DAYS=30           Gueltigkeit einer Anmeldung in Tagen
# MANTA_MIN_PASSWORD_LEN=10       Mindestlaenge neuer Passwoerter
# MANTA_SMTP_TIMEOUT=10           Zeitgrenze beim Mailversand, in Sekunden
# MANTA_NEO4J_CONNECT_TIMEOUT=5   Verbindungsaufbau zur Datenbank, in Sekunden
# MANTA_NEO4J_CONNECT_ATTEMPTS=30 Versuche beim Start, bevor aufgegeben wird
# MANTA_NEO4J_CONNECT_BACKOFF=2   Wartezeit zwischen den Versuchen, in Sekunden
# MANTA_BACKUP_KEEP=14            Wie viele Sicherungen deploy/backup.sh aufhebt
# OLLAMA_TEMPERATURE=0.2          Streuung der Assistenten-Antworten
# OLLAMA_NUM_CTX=8192             Kontextfenster des lokalen Modells
